<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {#- Page identity.
     `pageDescription` is set in a page's front matter where it has something
     specific to say; everything else falls back to the society's one-line
     description. Every page previously shipped with no description, no
     canonical and no social tags at all, which meant a link shared to
     Instagram — the society's main channel — rendered as a bare URL. #}
  {%- set metaTitle = title or pageTitle or name or competition or site.title %}
  {%- set metaDesc = pageDescription or description or caseSummary or bio or site.description %}
  {%- set metaImage = ogImage or photo or headerPhoto or image or "/assets/logo.jpg" %}
  <title>{{ metaTitle }} — {{ site.title }}</title>
  <meta name="description" content="{{ metaDesc | striptags | truncate(160) }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/logo.jpg" type="image/jpeg">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDesc | striptags | truncate(160) }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ metaImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ metaTitle }}">
  <meta name="twitter:description" content="{{ metaDesc | striptags | truncate(160) }}">
  <meta name="twitter:image" content="{{ site.url }}{{ metaImage }}">
  <meta name="theme-color" content="#1a2744">

  {#- Fonts are self-hosted (the @font-face rules are at the top of
     styles.css) rather than loaded from fonts.googleapis.com, so there is no
     second origin to preconnect to and no render-blocking third-party
     stylesheet to fetch before the browser can even start on the font files
     themselves. See the comment in styles.css for what changed and why.

     `preload` on the two base "latin" files (Inter normal, used everywhere,
     and Playfair Display normal, used in every heading) tells the browser to
     start fetching them immediately, in parallel with everything else in
     <head>, instead of waiting to discover them via styles.css's own
     @font-face rules partway through the render. The italic and latin-ext
     files are deliberately NOT preloaded — most page loads never touch
     italic text or a non-Latin character, and preloading a file the page
     turns out not to need delays the ones it does need. `crossorigin` is
     required even though the file is same-origin: fonts are always fetched
     in CORS mode by spec, and a preload without it is fetched again from
     scratch when styles.css requests it moments later. #}
  <link rel="preload" href="/assets/fonts/inter-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/playfair-display-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

<a class="skip-link" href="#main">Skip to main content</a>

<nav>
  <div class="nav-inner">
    <a href="/" class="logo">
      <img src="/assets/logo.jpg" alt="Guelph-Humber Pre-Law Society Logo">
      <span>Guelph-Humber Pre-Law Society</span>
    </a>
    {#- aria-expanded is not optional on a control that opens something: without
       it a screen reader announces "Menu, button" and never says whether the
       menu is now open or closed, so there is no feedback from pressing it.
       aria-controls names what it opens. #}
    <button class="hamburger" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="navMenu">
      <span></span><span></span><span></span>
    </button>
    <ul id="navMenu">
      <li><a href="/" {% if activePage == "home" %}class="active"{% endif %}>Home</a></li>
      <li><a href="/about/" {% if activePage == "about" %}class="active"{% endif %}>About</a></li>
      <li><a href="/achievements/" {% if activePage == "achievements" %}class="active"{% endif %}>Achievements</a></li>
      <li><a href="/ghcup/" {% if activePage == "ghcup" %}class="active"{% endif %}>GH Cup</a></li>
      <li><a href="/minimoot/" {% if activePage == "minimoot" %}class="active"{% endif %}>Mini Moot</a></li>
      <li><a href="/events/" {% if activePage == "events" %}class="active"{% endif %}>Events</a></li>
      <li><a href="/photos/" {% if activePage == "photos" %}class="active"{% endif %}>Photo Gallery</a></li>
      <li><a href="/materials/" {% if activePage == "materials" %}class="active"{% endif %}>Materials</a></li>
      <li><a href="/contact/" {% if activePage == "contact" %}class="active"{% endif %}>Contact</a></li>
    </ul>
  </div>
</nav>

<main id="main" tabindex="-1">
  {{ content | safe }}
</main>

<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/assets/logo.jpg" alt="GHPLS">
        <p>{{ site.description }}</p>
        <div class="footer-social">
          <a href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        </div>
      </div>
      <div>
        <h4>Pages</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/achievements/">Achievements</a></li>
          <li><a href="/ghcup/">The GH Cup</a></li>
          <li><a href="/minimoot/">The Mini Moot</a></li>
          <li><a href="/events/">Events</a></li>
          <li><a href="/photos/">Photo Gallery</a></li>
        </ul>
      </div>
      <div>
        <h4>Get Involved</h4>
        <ul>
          <li><a href="/contact/">Contact Us</a></li>
          <li><a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-legal-links">
        <a href="/privacy/">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/terms/">Terms of Use</a>
        <span aria-hidden="true">·</span>
        <a href="/accessibility/">Accessibility</a>
      </div>
      &copy; 2026 {{ site.title }}. All rights reserved.<br>
      <span class="footer-disclaimer">A student club at the University of Guelph-Humber. Not affiliated with or endorsed by the University.</span>
    </div>
  </div>
</footer>

<script>
(function () {
  var toggle = document.getElementById('navToggle');
  var menu = document.getElementById('navMenu');
  if (!toggle || !menu) return;

  // One function owns the open state, so the class and aria-expanded can never
  // drift apart and start telling sighted and screen-reader users different
  // things.
  function setOpen(open) {
    menu.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  toggle.addEventListener('click', function () {
    setOpen(!menu.classList.contains('open'));
  });
  menu.querySelectorAll('a').forEach(function (a) {
    a.addEventListener('click', function () { setOpen(false); });
  });
  // Escape closes it and returns focus to the control that opened it —
  // otherwise a keyboard user who dismisses the menu is left with focus
  // nowhere.
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && menu.classList.contains('open')) {
      setOpen(false);
      toggle.focus();
    }
  });
})();
</script>
</body>
</html>
