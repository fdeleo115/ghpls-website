---
layout: base.njk
pageTitle: Achievements
activePage: achievements
permalink: /achievements/
pageDescription: "Competition results for Guelph-Humber mooting teams, including the HSFK Cup, Highland Cup, Centre Block Cup, and Western Cup."
---
{% import "macros.njk" as m %}

{{ m.pageHeader(pageHeaders.achievements, "Competitive Achievements", "Our members have represented Guelph-Humber with distinction at moot competitions across the country.") }}

<section>
  <div class="container">
    <div class="wins-grid">
      {%- for item in collections.achievements %}
      <a href="/achievements/{{ item.fileSlug }}/" class="win-card win-card--link {% if item.data.photo %}win-card--has-photo{% endif %} {% if item.data.cardWidth == 'wide' %}win-card--wide{% endif %}">
        {% if item.data.photo %}
        {#- Cards sit two-up in a 1152px content column, so a normal card's
           photo is 564px wide and a full-width one is 1152px. Below 700px they
           stack and fill the viewport. #}
        {%- set cardSizes = "(max-width: 700px) 100vw, 1152px" if item.data.cardWidth == 'wide' else "(max-width: 700px) 100vw, (max-width: 1200px) 50vw, 564px" %}
        {%- set pos = item.data.photoPosition | cssPosition %}
        {%- set zoom = item.data.photoZoom | cssZoom %}
        <div class="win-card-photo win-card-photo--{{ item.data.photoHeight or 'medium' }}">
          <img src="{{ item.data.photo }}" alt="{{ item.data.competition }}" data-sizes="{{ cardSizes }}"{% if loop.index == 1 %} data-eager{% endif %} style="object-fit: {{ item.data.photoSize | cssFit }}; object-position: {{ pos }};{% if zoom %} transform: scale({{ zoom }}); transform-origin: {{ pos }};{% endif %}">
        </div>
        {% endif %}
        <div class="win-card-content">
          <div class="competition">{{ item.data.competition }}</div>
          <div class="year">{{ item.data.year }}{% if item.data.date %} · {{ item.data.date | dateFormat }}{% endif %}</div>
          {%- for result in item.data.results %}
          <div class="achievement">
            <span class="badge">{{ result.award }}</span>
            <span class="names">{{ result.recipients }}</span>
          </div>
          {%- endfor %}
          <span class="win-card-more">View details &#8594;</span>
        </div>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
