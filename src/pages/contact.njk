---
layout: base.njk
pageTitle: Contact
activePage: contact
permalink: /contact/
---

<section class="page-header{% if pageHeaders.contact.photo %} page-header--photo{% endif %}"{% if pageHeaders.contact.photo %} style="background-image:url('{{ pageHeaders.contact.photo }}'); background-position:{{ pageHeaders.contact.photoPosition or 'center' }};"{% endif %}>
  <div class="container">
    <h1>Contact Us</h1>
    <p>Have questions or want to get involved? We'd love to hear from you.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <h3>Get in Touch</h3>
        <p>Whether you're interested in joining the society, competing in The GH Cup, or partnering with us, reach out and we'll get back to you.</p>
        <div class="contact-links">
          <a href="{{ site.instagram }}" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            @ghpls on Instagram
          </a>
          <a href="{{ site.linkedin }}" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            LinkedIn
          </a>
          {% if site.email %}
          <a href="mailto:{{ site.email }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 6L2 7"/></svg>
            {{ site.email }}
          </a>
          {% endif %}
        </div>
      </div>
      {#- This was an on-page form carrying Netlify's `data-netlify` attributes.
         Those only do anything on Netlify, and the site moved to a Cloudflare
         Worker that has no form handling — so every "Send Message" returned a
         405 error page and no message ever arrived. Rather than fake a form
         with nowhere to POST, we send people to a Google Form (responses land
         in a Sheet the execs own) and always show the real contact routes
         underneath. #}
      <div class="contact-cta">
        <h3>Send us a message</h3>
        {%- if site.contactFormUrl %}
        <p>Fill in our short contact form and we'll get back to you by email.</p>
        <a class="btn btn-primary" href="{{ site.contactFormUrl }}" target="_blank" rel="noopener">Open the contact form<span class="visually-hidden"> (opens in a new tab)</span></a>
        {%- elif site.email %}
        <p>Email us and we'll get back to you as soon as we can. We read everything that comes in.</p>
        <a class="btn btn-primary" href="mailto:{{ site.email }}">Email {{ site.email }}</a>
        {%- endif %}
        <p class="contact-cta-alt">You can also reach us on <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a> or <a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>.</p>
      </div>
    </div>
  </div>
</section>
