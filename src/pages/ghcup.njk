---
layout: base.njk
pageTitle: The GH Cup
activePage: ghcup
permalink: /ghcup/
pageDescription: "The GH Cup is our flagship moot court competition, open to undergraduate students from universities across Ontario."
---
{% import "macros.njk" as m %}

{{ m.pageHeader(pageHeaders.ghcup, "The GH Cup", "Our flagship annual moot court competition.") }}

<section>
  <div class="container">
    {#- Banner photo lives in Page Content → Page Header Photos → GH Cup Page.
       See the matching note in minimoot.njk: the old "Banner Photo" field on
       this entry rendered a circle here, not the page header, and was a trap. #}
    <div class="ghcup-hero">
      <h3>{{ ghcup.headline }}</h3>
      <p>{{ ghcup.description }}</p>
      <a href="/contact/" class="btn btn-primary">Stay Updated</a>
    </div>
    <div class="ghcup-features">
      <div class="ghcup-feature">
        <h4>Compete</h4>
        <p>Test your advocacy skills against teams from universities across the province in a structured moot format.</p>
      </div>
      <div class="ghcup-feature">
        <h4>Judge</h4>
        <p>Law students, lawyers, and legal professionals are invited to volunteer as judges and provide feedback.</p>
      </div>
      <div class="ghcup-feature">
        <h4>Network</h4>
        <p>Connect with peers, mentors, and legal professionals in a competitive yet collaborative environment.</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-cream">
  <div class="container">
    <div class="section-header">
      <h2>What is The GH Cup?</h2>
      <div class="line"></div>
    </div>
    <div class="content-block">
      {#- The `paragraphs` filter escapes first and adds the <p> tags after,
         so multi-paragraph text still works without marking editor input
         as safe HTML. The old `replace(...) | safe` did the opposite. #}
      {{ ghcup.about | paragraphs | safe }}
      <h3>How It Works</h3>
      <ul>
        {%- for step in ghcup.howItWorks %}
        <li>{{ step }}</li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

{%- if ghcup.gallery and ghcup.gallery.length > 0 %}
<section>
  <div class="container">
    <div class="section-header">
      <h2>Competition Gallery</h2>
      <p>Moments from The GH Cup.</p>
      <div class="line"></div>
    </div>
    <div class="photo-gallery">
      {#- data-* attributes rather than interpolating into the onclick string —
         same reasoning as the note in events.njk. minimoot.njk already did
         this correctly; this page was the one still building JavaScript out of
         editor-supplied text. #}
      {%- for shot in ghcup.gallery %}
      <div class="photo-card" data-img="{{ shot.image }}" data-caption="{{ shot.caption }}" onclick="openLightbox(this.dataset.img, this.dataset.caption)">
        <img src="{{ shot.image }}" alt="{{ shot.caption }}" loading="lazy" data-sizes="(max-width: 640px) 100vw, (max-width: 1200px) 33vw, 373px" style="object-position: {{ shot.photoPosition | cssPosition }};">
        {%- if shot.caption %}
        <div class="photo-overlay">
          <h4>{{ shot.caption }}</h4>
        </div>
        {%- endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="bg-cream">
  <div class="container">
    <div class="section-header">
      <h2>Previous Winners</h2>
      <p>Celebrating the champions of past GH Cup competitions.</p>
      <div class="line"></div>
    </div>
    <div class="winners-timeline">
      {%- for winner in collections.ghcupWinners %}
      {%- set wpos = winner.data.photoPosition | cssPosition %}
      {%- set wzoom = winner.data.photoZoom | cssZoom %}
      <div class="winner-card {% if not winner.data.photo %}winner-card--no-photo{% endif %}">
        {% if winner.data.photo %}
        <div class="winner-photo">
          <img src="{{ winner.data.photo }}" alt="{{ winner.data.year }} GH Cup" loading="lazy" data-sizes="(max-width: 700px) 100vw, 240px" style="object-fit: {{ winner.data.photoSize | cssFit }}; object-position: {{ wpos }};{% if wzoom %} transform: scale({{ wzoom }}); transform-origin: {{ wpos }};{% endif %}">
        </div>
        {% endif %}
        <div class="winner-info">
          <div class="winner-year">{{ winner.data.year }}</div>
          <h3>{{ winner.data.theme }}</h3>
          {%- for award in winner.data.awards %}
          <div class="winner-award">
            <span class="badge">{{ award.title }}</span>
            <span class="names">{{ award.recipients }}</span>
          </div>
          {%- endfor %}
          {% if winner.data.caseTitle %}
          <div class="winner-case">Case: <em>{{ winner.data.caseTitle }}</em></div>
          {% endif %}
        </div>
      </div>
      {%- endfor %}
      {%- if collections.ghcupWinners.length == 0 %}
      <p class="empty-state">Previous winners will appear here as they're added.</p>
      {%- endif %}
    </div>
  </div>
</section>

{%- if collections.ghcupVideos.length > 0 %}
<section>
  <div class="container">
    <div class="section-header">
      <h2>Final Videos</h2>
      <p>Watch the moot finals from past GH Cup competitions.</p>
      <div class="line"></div>
    </div>
    <div class="video-grid">
      {%- for video in collections.ghcupVideos %}
      <div class="video-card">
        <div class="video-embed">
          <iframe src="https://www.youtube-nocookie.com/embed/{{ video.data.url | youtubeId }}" title="{{ video.data.title or video.data.year }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        </div>
        <div class="video-info">
          <div class="winner-year">{{ video.data.year }}</div>
          <h3>{{ video.data.title or "GH Cup Final" }}</h3>
          {% if video.data.description %}<p>{{ video.data.description }}</p>{% endif %}
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="bg-cream">
  <div class="container">
    <div class="section-header">
      <h2>Sponsors & Partners</h2>
      <p>We're grateful for the support that makes The GH Cup possible.</p>
      <div class="line"></div>
    </div>
    <div class="sponsors-row">
      <div class="sponsor-slot">Sponsor Logo</div>
      <div class="sponsor-slot">Sponsor Logo</div>
      <div class="sponsor-slot">Sponsor Logo</div>
    </div>
    {#- --peach-ink, not --peach: this link sits on the cream section
       background, where peach measures about 1.9:1 and fails WCAG AA. The
       rule is written down in styles.css above .cal-add; this inline style
       was quietly breaking it. #}
    <p style="text-align:center; margin-top:32px; color:var(--text-light);">Interested in sponsoring? <a href="/contact/" style="color:var(--peach-ink); font-weight:600;">Get in touch</a></p>
  </div>
</section>

<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
  <img id="lightbox-img" src="" alt="">
  <div id="lightbox-caption" class="lightbox-caption"></div>
</div>
<script>
function openLightbox(src, caption) {
  document.getElementById('lightbox-img').src = src;
  document.getElementById('lightbox-caption').textContent = caption;
  document.getElementById('lightbox').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('open');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>
