---
layout: base.njk
pageTitle: Photo Gallery
activePage: photos
permalink: /photos/
pageDescription: "Photographs from Guelph-Humber Pre-Law Society events, moot competitions, and trips."
---
{% import "macros.njk" as m %}

{{ m.pageHeader(pageHeaders.photos, "Guelph-Humber Pre-Law Society Gallery", "Highlights from our events, competitions, and community.") }}

<section>
  <div class="container">
    <div class="photo-gallery">
      {%- for photo in collections.photos %}
      <div class="photo-card photo-{{ photo.data.size or 'normal' }}"
           data-img="{{ photo.data.image }}"
           data-title="{{ photo.data.title }}"
           data-desc="{{ photo.data.description }}"
           onclick="openLightbox(this.dataset.img, this.dataset.title, this.dataset.desc)">
        {#- Three-column grid in a 1152px column, so ~373px per cell; full
           width once the grid collapses on a phone. #}
        <img src="{{ photo.data.image }}" alt="{{ photo.data.title }}" loading="lazy" data-sizes="(max-width: 640px) 100vw, (max-width: 1200px) 33vw, 373px" style="object-position: {{ photo.data.photoPosition | cssPosition }};">
        <div class="photo-overlay">
          <h4>{{ photo.data.title }}</h4>
          {% if photo.data.description %}<p>{{ photo.data.description }}</p>{% endif %}
          {% if photo.data.date %}<span>{{ photo.data.date | dateFormat }}</span>{% endif %}
        </div>
      </div>
      {%- endfor %}
      {%- if collections.photos.length == 0 %}
      <p class="empty-state">Photos will appear here as they're added. Check back soon!</p>
      {%- endif %}
    </div>
  </div>
</section>

<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
  <img id="lightbox-img" src="" alt="">
  <div class="lightbox-caption">
    <h4 id="lightbox-title"></h4>
    <p id="lightbox-desc"></p>
  </div>
</div>

<script>
function openLightbox(src, title, desc) {
  document.getElementById('lightbox-img').src = src;
  var t = document.getElementById('lightbox-title');
  var d = document.getElementById('lightbox-desc');
  t.textContent = title || '';
  d.textContent = desc || '';
  d.style.display = desc ? 'block' : 'none';
  document.getElementById('lightbox').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('open');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>
