---
layout: base.njk
pageTitle: Materials
activePage: materials
permalink: /materials/
pageDescription: "Free guides and resources to help you prepare for moot competitions and develop your legal advocacy skills."
---
{% import "macros.njk" as m %}

{{ m.pageHeader(pageHeaders.materials, "Public Materials", "Resources to help you prepare for competitions and develop your legal advocacy skills.") }}

<section>
  <div class="container">
    <div class="materials-grid">
      {%- for item in materials.items %}
      <div class="material-card">
        <div class="file-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#1a2744" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <h2>{{ item.title }}</h2>
        <p>{{ item.description }}</p>
        {% if item.file %}
        {#- `download` only works same-origin. On a cross-origin href the browser
            ignores it entirely, so a card linking to Google Docs was labelled
            "Download" while actually just navigating. External links instead get
            rel="noopener" and rely on the target sending Content-Disposition —
            which a Google Docs /export?format=pdf URL does. A /edit URL does not,
            and must never be used here (see the CMS hint on this field).
            aria-label distinguishes buttons that would otherwise all announce as
            the single word "Download". #}
        {%- set isExternal = item.file.startsWith("http") %}
        <a href="{{ item.file }}" class="btn btn-primary"
           {%- if isExternal %} rel="noopener"{% else %} download{% endif %}
           aria-label="Download {{ item.title }}">Download</a>
        {% else %}
        <span class="btn btn-soon">Coming Soon</span>
        {% endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
