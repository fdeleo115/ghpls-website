---
layout: base.njk
pageTitle: Events
activePage: events
permalink: /events/
pageDescription: "Upcoming workshops, panels and socials from the Guelph-Humber Pre-Law Society, with RSVP and calendar links."
---
{% import "macros.njk" as m %}

{{ m.pageHeader(pageHeaders.events, "Events", "Stay up to date with our upcoming events and workshops.") }}

<section>
  <div class="container">
    <div class="section-header">
      <h2>Upcoming Events</h2>
      <div class="line"></div>
    </div>
    <div class="schedule-list">
      {%- for event in collections.events %}
      <div class="schedule-item {% if event.data.photo %}schedule-item--has-photo{% endif %}">
        {% if event.data.photo %}
        <div class="schedule-photo">
          <img src="{{ event.data.photo }}" alt="{{ event.data.title }}" data-sizes="(max-width: 848px) 100vw, 800px" style="object-fit: {{ event.data.photoSize | cssFit }}; object-position: {{ event.data.photoPosition | cssPosition }};">
        </div>
        {% endif %}
        <div class="schedule-date">
          <div class="month">{{ event.data.date | monthShort }}</div>
          <div class="day">{{ event.data.date | dayNum }}</div>
        </div>
        <div class="schedule-info">
          <h4>{{ event.data.title }}</h4>
          <p>{{ event.data.description }}</p>
          {% if event.data.time %}<div class="time">{{ event.data.time }}</div>{% endif %}
          {% if event.data.location %}<div class="location">{{ event.data.location }}</div>{% endif %}
          {#- RSVPs go to a Google Form so responses land in a Sheet the execs
             own and can hand on. The site is served by a Cloudflare Worker with
             no form handling, so an on-page form would have nowhere to POST —
             it used to carry Netlify's `data-netlify` attributes, which are
             inert off Netlify and made every submission 405. When no form URL
             is configured we fall back to email rather than show a dead
             control. #}
          {%- if event.data.rsvp != false %}
          <div class="schedule-rsvp">
            {%- if site.rsvpFormUrl %}
            {%- set rsvpLink = site.rsvpFormUrl %}
            {%- if site.rsvpFormEventField %}
            {%- set joiner = "&" if "?" in site.rsvpFormUrl else "?" %}
            {%- set rsvpLink = site.rsvpFormUrl + joiner + "usp=pp_url&" + site.rsvpFormEventField + "=" + (event.data.title | urlencode) %}
            {%- endif %}
            <a class="btn btn-primary rsvp-link" href="{{ rsvpLink }}" target="_blank" rel="noopener">RSVP for this event<span class="visually-hidden"> (opens in a new tab)</span></a>
            {%- elif site.email %}
            <a class="btn btn-primary rsvp-link" href="mailto:{{ site.email }}?subject={{ ('RSVP: ' + event.data.title) | urlencode }}">RSVP by email</a>
            {%- endif %}
          </div>
          {%- endif %}
          {#- Add to Calendar. A <details> disclosure rather than a scripted
             dropdown: it needs no JavaScript, is keyboard accessible and
             screen-reader announced for free, and cannot break at runtime —
             the same reasoning that put RSVP on a plain link.

             Two routes because one doesn't cover everyone: the .ics file is
             what opens Apple Calendar directly when tapped on an iPhone and
             imports into Outlook, while Google Calendar users are far better
             served by a pre-filled link than by downloading a file and
             importing it. The .ics is generated at build time by
             src/event-ics.njk. #}
          <details class="cal-add">
            <summary>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Add to Calendar
            </summary>
            <div class="cal-add-menu">
              <a href="{{ event.data | googleCalendarUrl }}" target="_blank" rel="noopener">Google Calendar<span class="visually-hidden"> (opens in a new tab)</span></a>
              <a href="/events/{{ event.fileSlug }}.ics" download>Apple Calendar / Outlook<span class="visually-hidden"> (downloads a calendar file)</span></a>
            </div>
          </details>
        </div>
      </div>
      {%- endfor %}
      {%- if collections.events.length == 0 %}
      <p class="empty-state">No upcoming events scheduled. Follow us on <a href="{{ site.instagram }}">Instagram</a> for announcements.</p>
      {%- endif %}
    </div>
  </div>
</section>

<section class="bg-cream">
  <div class="container">
    <div class="section-header">
      <h2>Past Events</h2>
      <div class="line"></div>
    </div>
    <div class="past-events-grid">
      {%- for event in collections.pastEvents %}
      <div class="past-event-card">
        {% if event.data.photo %}
        <img src="{{ event.data.photo }}" alt="{{ event.data.title }}" class="past-event-img" data-sizes="(max-width: 700px) 100vw, (max-width: 1200px) 50vw, 564px" style="object-fit: {{ event.data.photoSize | cssFit }}; object-position: {{ event.data.photoPosition | cssPosition }};">
        {% endif %}
        <div class="past-event-info">
          <div class="past-event-date">{{ event.data.date | dateFormat }}</div>
          <h4>{{ event.data.title }}</h4>
          <p>{{ event.data.description }}</p>
        </div>
        {% if event.data.extraPhotos %}
        <div class="past-event-extras">
          {#- data-* attributes, NOT interpolation into the onclick string.
             Building JavaScript by string concatenation in an attribute is
             unsafe here even though Nunjucks escapes the value: it escapes for
             HTML, so an apostrophe becomes &#39;, and the HTML parser turns
             that back into a bare ' before the JavaScript is parsed — closing
             the string literal early. A caption reading "Ireland's trip" broke
             the button outright, and a crafted one would have run script.
             Every other lightbox on the site already reads from dataset; these
             two were simply missed. #}
          {%- for extra in event.data.extraPhotos %}
          <div class="extra-photo" data-img="{{ extra.image }}" data-caption="{{ extra.caption or event.data.title }}" onclick="openLightbox(this.dataset.img, this.dataset.caption)">
            <img src="{{ extra.image }}" alt="{{ extra.caption or event.data.title }}" loading="lazy" data-sizes="80px">
          </div>
          {%- endfor %}
        </div>
        {% endif %}
      </div>
      {%- endfor %}
      {%- if collections.pastEvents.length == 0 %}
      <p class="empty-state">Past events will appear here as they're added.</p>
      {%- endif %}
    </div>
  </div>
</section>

<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
  <img id="lightbox-img" src="" alt="">
  <div id="lightbox-caption" class="lightbox-caption"></div>
</div>
<script>
function openLightbox(src, caption) {
  document.getElementById('lightbox-img').src = src;
  document.getElementById('lightbox-caption').textContent = caption;
  document.getElementById('lightbox').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('open');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>
