# Dependencies — reinstalled from package.json, never committed
node_modules/

# Build output — Netlify regenerates this on every deploy
_site/

# Environment / secrets — never commit these
.env
.env.*
*.local

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Generated image variants — a build cache, not source. Safe to delete;
# rebuilding it just takes a few minutes.
.image-cache/

# Local wrangler dev-server state (miniflare's SQLite cache/observability
# files) — created by `wrangler dev`, never something to commit.
.wrangler/
